<?xml version="1.0" encoding="utf-8"?>
<!-- 암호화되지 않은 http 통신 금지, 사용자가 설치한 인증서(중간자 가로채기용)는 믿지 않는다 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
